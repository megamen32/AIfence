package views

import "github.com/airlockrun/agentsdk/lucide"

templ Index(v HomeView) {
    @Layout("Wordstat | Поисковый спрос") {
        <header data-airlock-standalone-only class="mb-6 flex items-start gap-3">
            @lucide.Icon("chart-no-axes-combined", "size-7 mt-1 shrink-0")
            <div>
                <h1 class="text-2xl font-semibold">Wordstat</h1>
                <p class="text-base-content/70">Фразы, динамика и география поискового спроса</p>
            </div>
        </header>
        <div class="alert alert-warning mb-5 items-start" role="note">
            @lucide.Icon("calendar-clock", "size-5 shrink-0")
            <div class="min-w-0">
                <strong>Доступна только историческая статистика</strong>
                <p class="mt-1 text-sm">После 7 октября 2026 года API не получает новые данные. Для сравнения полных месяцев выбирайте сентябрь 2026 или раньше.</p>
            </div>
        </div>
        <form id="wordstat-form" class="space-y-4" method="post" action="/query" hx-post="/query" hx-trigger="submit" hx-target="#results" hx-swap="innerHTML" hx-disable="find button[type='submit']">
            <label class="block">
                <span class="mb-2 block font-medium">Поисковая фраза</span>
                <input class="input w-full" type="text" name="phrase" id="phrase" list="phrase-examples" placeholder="Например, касперский для бизнеса" maxlength="400" required/>
                <datalist id="phrase-examples">
                    for _, phrase := range v.Presets {
                        <option value={ phrase }></option>
                    }
                </datalist>
            </label>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <label class="block min-w-0">
                    <span class="mb-2 block text-sm">Исследование</span>
                    <select class="select w-full" name="kind">
                        <option value="top">Запросы и похожие формулировки</option>
                        <option value="dynamics">Динамика по месяцам</option>
                        <option value="regions">Распределение по регионам</option>
                    </select>
                </label>
                <label class="block min-w-0">
                    <span class="mb-2 block text-sm">География для распределения</span>
                    <select class="select w-full" name="region_mode">
                        <option value="regions">Регионы</option>
                        <option value="cities">Города</option>
                        <option value="all">Все уровни</option>
                    </select>
                </label>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <label class="block min-w-0">
                    <span class="mb-2 block text-sm">Регион для фраз и динамики</span>
                    <input class="input w-full" type="text" name="region_ids" value="225" inputmode="numeric"/>
                    <span class="mt-1 block text-xs text-base-content/65">225: Россия. Пустое поле: без фильтра. Несколько кодов через запятую.</span>
                </label>
                <label class="block min-w-0">
                    <span class="mb-2 block text-sm">Устройства для фраз и динамики</span>
                    <select class="select w-full" name="device">
                        <option value="all">Все устройства</option>
                        <option value="desktop">Компьютеры</option>
                        <option value="phone">Телефоны</option>
                        <option value="tablet">Планшеты</option>
                    </select>
                </label>
            </div>
            <fieldset class="rounded-box border border-base-300 p-4">
                <legend class="px-2 text-sm">Период для динамики</legend>
                <p class="mb-3 text-xs text-base-content/65">Помесячная динамика поддерживает только оператор +. Для остальных операторов используйте исследование фраз.</p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <label class="block min-w-0">
                        <span class="mb-2 block text-sm">Первый месяц</span>
                        <input class="input w-full" name="from_month" type="month" value="2025-10"/>
                    </label>
                    <label class="block min-w-0">
                        <span class="mb-2 block text-sm">Последний месяц</span>
                        <input class="input w-full" name="to_month" type="month" value="2026-09"/>
                    </label>
                </div>
                <p class="mt-3 text-xs text-base-content/65">У запросов и распределения по регионам точное окно API не сообщается. Оно не зависит от выбранных здесь месяцев.</p>
            </fieldset>
            <button type="submit" class="btn btn-primary">
                @ActionIcon("search")
                <span>Исследовать спрос</span>
            </button>
        </form>
        <section id="results" class="mt-6 min-w-0" aria-live="polite">
            <p class="text-sm text-base-content/65">Введите фразу или выберите пример в поле поиска. Запрос запускается кнопкой.</p>
        </section>
        <footer class="mt-8 border-t border-base-300 pt-4 text-xs text-base-content/65">
            <p>Частотность показывает поисковые запросы. Она не измеряет число покупателей, заказы или выручку. Частотности пересекающихся фраз нельзя складывать.</p>
            <a class="link mt-2 inline-flex items-center gap-1" href="https://aistudio.yandex.ru/ru/docs/search-api/concepts/wordstat" target="_blank" rel="noopener noreferrer">
                Документация источника
                @lucide.Icon("external-link", "size-3")
            </a>
        </footer>
    }
}

templ Result(v ResultView) {
    <div class="space-y-4 min-w-0">
        if v.Status != "ok" {
            <div class="alert items-start" role="status">
                @lucide.Icon("circle-alert", "size-5 shrink-0")
                <div class="min-w-0">
                    <p>{ v.Message }</p>
                    if v.Period != "" {
                        <p class="mt-2 text-sm">Запрошен период: <strong>{ v.Period }</strong></p>
                    }
                </div>
            </div>
        } else {
            <div>
                <h2 class="text-lg font-semibold break-words">{ v.Phrase }</h2>
                <p class="text-sm text-base-content/70">{ v.Message }</p>
                if v.Period != "" {
                    <p class="mt-1 text-sm">Запрошен период: { v.Period }</p>
                }
            </div>
        }
        if len(v.Rows) > 0 {
            <div class="overflow-x-auto rounded-box border border-base-300">
                <table class="table table-sm">
                    <thead>
                        <tr><th>Фраза, период или регион</th><th class="text-right">Запросы</th><th>Раздел</th></tr>
                    </thead>
                    <tbody>
                        for _, row := range v.Rows {
                            <tr>
                                <td class="whitespace-normal break-words">{ row.Label }</td>
                                <td class="text-right tabular-nums">{ row.Count }</td>
                                <td class="text-xs">{ row.Group }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        if v.WindowNote != "" {
            <p class="text-sm text-base-content/65">{ v.WindowNote }</p>
        }
        if v.Raw != "" {
            <details class="rounded-box border border-base-300 p-3">
                <summary class="cursor-pointer text-sm">Исходный ответ Wordstat</summary>
                <pre class="mt-3 overflow-auto max-h-96 whitespace-pre-wrap break-all text-xs">{ v.Raw }</pre>
            </details>
        }
        if v.CheckedAt != "" {
            <p class="text-xs text-base-content/60">Время обращения: { v.CheckedAt }. Дата обращения не является датой данных.</p>
        }
    </div>
}
