package views
import "github.com/airlockrun/agentsdk/lucide"

templ TermCard(term string,index int) {
 <div class="comparison-card" data-comparison-card data-series={ Number(index) }>
  <span class="series-dot" aria-hidden="true"></span>
  <label class="comparison-name">
   <span class="comparison-caption">Поисковая фраза</span>
   <input name="terms" value={ term } aria-label={ "Поисковая фраза "+Number(index+1) } placeholder="Например, Dr.Web" maxlength="200" required autocomplete="off"/>
  </label>
  <button type="button" class="icon-button remove-term" data-remove-term aria-label={ "Удалить сравнение: "+term } title="Удалить фразу">
   @lucide.Icon("x","size-4")
  </button>
 </div>
}
templ Page(f Form,result *ResultModel) {
 @Layout() {
  <header data-airlock-standalone-only class="explorer-heading">
   <div class="heading-mark">@lucide.Icon("chart-line","size-6")</div>
   <div><h1>Google Trends</h1><p>Сравнивайте интерес к продуктам и рынкам</p></div>
  </header>
  <form action="/query" method="post" id="research-form" data-research-form data-today={ f.Today } data-loading="false" hx-post="/query" hx-trigger="submit" hx-target="#results" hx-swap="innerHTML" hx-disable="find input, find select, find button" hx-sync="this:drop" class="research-form">
   <div class="research-topline">
    <fieldset class="analysis-modes">
     <legend class="sr-only">Вид исследования</legend>
     <label><input type="radio" name="mode" value="compare" checked?={ f.Mode=="compare" }/><span>Динамика</span></label>
     <label><input type="radio" name="mode" value="regions" checked?={ f.Mode=="regions" }/><span>Регионы</span></label>
     <label><input type="radio" name="mode" value="related" checked?={ f.Mode=="related" }/><span>Связанные запросы</span></label>
    </fieldset>
    <span class="term-limit" data-term-limit hidden>Добавлено 5 из 5 фраз</span>
   </div>
   <div class="comparison-list" data-comparison-list>
    for i,term:=range f.Terms {
     @TermCard(term,i)
    }
    <button type="button" class="add-comparison" data-add-term>
     @lucide.Icon("plus","size-5")
     <span>Добавить сравнение</span>
    </button>
   </div>
   <div class="filter-bar">
    <div class="filter-control geo-control" data-geo-control>
     <label for="geo-search">Регион</label>
     <div class="geo-input-wrap">
      @lucide.Icon("map-pin","size-4")
      <input id="geo-search" data-geo-search type="text" value={ f.GeoLabel } role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="geo-options" autocomplete="off" spellcheck="false"/>
      @lucide.Icon("chevron-down","size-4")
     </div>
     <input type="hidden" name="geo" value={ f.Geo }/>
     <div class="geo-menu" data-geo-menu hidden>
      <div class="geo-options" id="geo-options" role="listbox" aria-label="Регионы Google Trends" data-geo-list></div>
      <p class="geo-hint" data-geo-hint></p>
     </div>
    </div>
    <label class="filter-control">
     <span>Период</span>
     <select name="period_preset" aria-label="Период сравнения">
      <option value="12m" selected?={ f.PeriodPreset=="12m" }>12 полных месяцев</option>
      <option value="3m" selected?={ f.PeriodPreset=="3m" }>3 полных месяца</option>
      <option value="1m" selected?={ f.PeriodPreset=="1m" }>Прошлый месяц</option>
      <option value="last-year" selected?={ f.PeriodPreset=="last-year" }>Прошлый год</option>
      <option value="custom" selected?={ f.PeriodPreset=="custom" }>Свой период</option>
     </select>
    </label>
    <label class="filter-control search-property">
     <span>Где ищут</span>
     <select name="property" aria-label="Источник поиска">
      <option value="web" selected?={ f.Property=="web" }>Веб-поиск</option>
      <option value="youtube" selected?={ f.Property=="youtube" }>YouTube</option>
      <option value="news" selected?={ f.Property=="news" }>Новости</option>
      <option value="images" selected?={ f.Property=="images" }>Картинки</option>
      <option value="froogle" selected?={ f.Property=="froogle" }>Покупки</option>
     </select>
    </label>
    <button type="submit" class="btn btn-primary submit-research">
     @ActionIcon("search")
     <span data-submit-label>Показать интерес</span>
    </button>
   </div>
   <div class="custom-dates" data-custom-dates hidden>
    <label>С<input type="date" name="from" value={ f.From } min="2004-01-01" required class="input"/></label>
    <label>По<input type="date" name="to" value={ f.To } min="2004-01-01" required class="input"/></label>
   </div>
   <div class="secondary-filters">
    <div class="period-caption-wrap"><span class="period-caption" data-period-caption></span><button type="button" class="edit-dates" data-edit-dates>Изменить даты</button></div>
    <label class="related-picker" data-related-picker hidden?={ f.Mode!="related" }>
     <span>Для фразы</span>
     <select class="select select-sm" name="related_term" aria-label="Фраза для связанных запросов">
      for i,term:=range f.Terms {
       <option value={ Number(i) } selected?={ f.RelatedTerm==i }>{ term }</option>
      }
     </select>
    </label>
    <label class="region-level" data-region-level hidden?={ f.Mode!="regions" }>
     <span>Показывать</span>
     <select class="select select-sm" name="region" aria-label="Уровень географии">
      <option value="region" selected?={ f.Region=="region" }>Регионы</option>
      <option value="country" selected?={ f.Region=="country" }>Страны</option>
      <option value="city" selected?={ f.Region=="city" }>Города</option>
      <option value="dma" selected?={ f.Region=="dma" }>Медиарынки DMA</option>
     </select>
    </label>
    <details class="advanced-filter">
     <summary>@lucide.Icon("sliders-horizontal","size-3.5")<span>Категория</span></summary>
     <label>Категория поиска<input name="category" value={ f.Category } class="input input-sm" inputmode="numeric" maxlength="5"/><small>Все категории, если поле не заполнено</small></label>
    </details>
   </div>
   <p class="form-error" data-form-error role="alert" hidden></p>
  </form>
  <template id="comparison-template">@TermCard("",0)</template>
  <div class="draft-notice" data-draft-notice hidden>
   @lucide.Icon("info","size-4")
   <span>Параметры изменены. График ниже относится к предыдущему запросу.</span>
  </div>
  <div id="query-feedback" aria-live="polite">
   if result!=nil&&result.IsError() {
    @Feedback(*result)
   }
  </div>
  <section id="results" class="research-results" aria-label="Результаты исследования">
   if result!=nil&&!result.IsError() {
    @Results(*result)
   } else {
    @EmptyResearch()
   }
  </section>
 }
}
templ EmptyResearch() {
 <div class="empty-research">
  <div class="empty-icon">@lucide.Icon("chart-line","size-7")</div>
  <h2>Посмотрите, как меняется интерес</h2>
  <p>Добавьте продукты или рыночные формулировки и получите их динамику в одной шкале.</p>
  <div class="empty-labels"><span>Kaspersky Endpoint Security</span><span>Astra Linux</span><span>Dr.Web</span></div>
  <small>Поисковый интерес, индекс 0–100</small>
 </div>
}
templ Feedback(r ResultModel) {
 <div class="query-feedback query-feedback-error" data-query-error role="alert">
  @lucide.Icon("circle-alert","size-5 shrink-0")
  <div><strong>Не удалось обновить сравнение</strong><p>{ r.Message }</p><small>Предыдущий результат, если он был, остаётся на экране.</small></div>
 </div>
}
templ Results(r ResultModel) {
 <div class="result-record" data-result data-request={ r.RequestJSON } data-status={ r.Status }>
  <div class="result-heading">
   <div><h2>{ r.Title }</h2><p>{ r.Geo }<span> • </span>{ r.Property }<span> • </span>{ r.Period }</p></div>
   <span class="stale-badge" data-result-stale hidden>Параметры изменены</span>
  </div>
  if r.Status=="insufficient_data" {
   <div class="empty-research empty-result">
    @lucide.Icon("chart-line","size-8")
    <h3>Для этого сравнения недостаточно данных</h3>
    <p>Попробуйте более широкую формулировку, другой регион или длиннее период.</p>
   </div>
  } else if len(r.Series)>0 {
   @InteractiveChart(r)
  } else if len(r.Regions)>0 {
   <div class="region-chart">
    <div class="compact-legend">
     for i,term:=range r.Terms {
      <span data-series={ Number(i) }><i class="series-dot"></i>{ term }</span>
     }
    </div>
    for _,row:=range r.Regions {
     <div class="region-row"><h3>{ row.Label }</h3><div>
      for i,cell:=range row.Cells {
       <div class="region-value" data-series={ Number(i) }>
        if cell.Index!=nil {
         <progress max="100" value={ ScoreValue(cell.Index) } aria-label={ r.Terms[i]+" / "+row.Label }></progress>
        }
        <span>{ cell.Label }</span>
       </div>
      }
     </div></div>
    }
    <p class="chart-footnote">Относительный интерес по регионам. Полный список доступен в таблице ниже.</p>
   </div>
  } else if len(r.Popular)>0||len(r.Rising)>0 {
   <div class="related-panels">
    @RelatedList("Популярные запросы",r.Popular)
    @RelatedList("Растущие запросы",r.Rising)
   </div>
  }
  <div class="result-footer">
   <p>Google Trends · HasData<span> • </span>Поисковые фразы<span> • </span>
    if r.Mode == "related" {
     <span>Популярные: 0–100; растущие: рост в % или Breakout</span>
    } else {
     <span>Относительный индекс 0–100</span>
    }
   </p>
   <a href={ r.ExploreURL } target="_blank" rel="noopener noreferrer">@lucide.Icon("external-link","size-3.5")<span>Открыть источник</span></a>
  </div>
  <div class="result-details">
   <details class="data-details">
    <summary><span>Таблица данных</span><span class="detail-count">{ Number(len(r.Rows)) } строк</span>@lucide.Icon("chevron-down","size-4")</summary>
    <div class="data-table-scroll">
     <table class="table table-sm">
      <thead><tr><th>Интервал / регион / запрос</th>
       for _,term:=range r.Terms {
        <th>{ term }</th>
       }
      </tr></thead>
      <tbody>
       for _,row:=range r.Rows {
        <tr><th><span>{ row.Label }</span><small>{ row.Detail }</small></th>
         for _,cell:=range row.Cells {
          <td><strong>{ cell.Label }</strong>
           if cell.Detail!="" {
            <small>{ cell.Detail }</small>
           }
          </td>
         }
        </tr>
       }
      </tbody>
     </table>
    </div>
   </details>
   <details class="source-details">
    <summary><span>Как читать данные и сведения об источнике</span>@lucide.Icon("chevron-down","size-4")</summary>
    <div class="source-body">
     for _,note:=range r.Notes {
      <p>{ note }</p>
     }
     <p>Подсказка показывает исходные значения всех фраз. Пропуск, «&lt;1», ноль и незавершенный интервал сохранены отдельно. Недельный интервал может пересекать границу выбранного периода.</p>
     <p>Проверено: { r.Checked }</p>
     <p>{ r.SourceDetails }</p>
    </div>
   </details>
  </div>
 </div>
}
templ InteractiveChart(r ResultModel) {
 <div class="interactive-chart" data-chart={ r.ChartJSON }>
  <div class="chart-legend" aria-label="Серии графика">
   for i,s:=range r.Series {
    <button type="button" class="series-toggle" data-series-toggle={ Number(i) } data-series={ Number(i) } aria-pressed="true" aria-label={ "Показывать на графике: "+s.Name }>
     <span class="series-dot"></span>
     <span class="series-title">{ s.Name }</span>
     if i<len(r.Metrics) {
      <span class="series-average"><small>среднее</small><strong>{ r.Metrics[i].Value }</strong></span>
     }
    </button>
   }
  </div>
  <div class="chart-stage" data-chart-stage tabindex="0" role="group" aria-roledescription="интерактивный график" aria-label="Интерес во времени. Стрелки влево и вправо выбирают интервал." aria-describedby="chart-help">
   <div class="chart-y-axis" aria-hidden="true"><span>100</span><span>75</span><span>50</span><span>25</span><span>0</span></div>
   <div class="chart-plot" data-chart-plot>
    <svg viewBox="0 0 1000 300" preserveAspectRatio="none" aria-hidden="true" class="chart-svg">
     <g class="chart-grid"><line x1="0" y1="0" x2="1000" y2="0"/><line x1="0" y1="75" x2="1000" y2="75"/><line x1="0" y1="150" x2="1000" y2="150"/><line x1="0" y1="225" x2="1000" y2="225"/><line x1="0" y1="300" x2="1000" y2="300"/></g>
     for _,s:=range r.Series {
      <g data-chart-line={ Number(s.Index) } data-series={ Number(s.Index) }>
       for _,segment:=range s.Segments {
        <polyline points={ segment } fill="none" class="chart-line" vector-effect="non-scaling-stroke"/>
       }
      </g>
     }
    </svg>
    <div class="chart-crosshair" data-crosshair hidden></div>
    <div class="chart-markers" data-chart-markers></div>
    <p class="chart-all-hidden" data-chart-all-hidden hidden>Все фразы скрыты. Нажмите на название над графиком.</p>
   </div>
   <div class="chart-x-axis" data-x-axis aria-hidden="true"></div>
   <div class="chart-tooltip" data-chart-tooltip role="tooltip" hidden>
    <div class="point-heading"><strong data-tooltip-date></strong><button type="button" data-tooltip-close class="icon-button" aria-label="Закрыть подсказку">@lucide.Icon("x","size-4")</button></div>
    <p class="point-quality" data-tooltip-quality></p>
    <div data-tooltip-values></div>
   </div>
  </div>
  <div class="chart-bottomline">
   <p id="chart-help">@lucide.Icon("move-horizontal","size-4")<span>Наведите курсор или коснитесь графика. С клавиатуры: ← →</span></p>
   if r.CommonPoints>0 {
    <p>Средние: { Number(r.CommonPoints) } из { Number(r.TotalPoints) } общих полных интервалов</p>
   } else {
    <p>Недостаточно общих полных интервалов для средних</p>
   }
  </div>
  <p class="sr-only" data-chart-live aria-live="polite" aria-atomic="true"></p>
 </div>
}
templ RelatedList(title string,items []RelatedItem) {
 <div class="related-panel"><h3>{ title }</h3>
  for _,item:=range items {
   <div class="related-item"><span>{ item.Query }</span><strong>{ item.Value }<small>{ item.Metric }</small></strong></div>
  }
 </div>
}
