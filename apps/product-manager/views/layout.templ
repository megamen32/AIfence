package views

import "github.com/airlockrun/agentsdk"

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="ru">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="stylesheet" href={ AppCSSPath }/>
			<meta name="htmx-config" content='{"noSwap":[204,304,401]}'/>
			<script src={ agentsdk.Assets.HTMX }></script>
			@agentsdk.WebUI(agentsdk.WebUIOptions{})
		</head>
		<body>
			<main class="pm-shell">
				{ children... }
			</main>
		</body>
	</html>
}
