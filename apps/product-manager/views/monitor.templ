package views

import "github.com/airlockrun/agentsdk/lucide"

templ MonitorPanel(m *Monitor) {
	<section class="pm-dashboard" aria-label="Продуктовый мониторинг">
		<dl class="dashboard-status">
			<div><dt>Полный каталог</dt><dd>
				if m.Catalog != nil && m.Catalog.Count != "" {
					{ m.Catalog.Count }
				} else {
					—
				}
			</dd></div>
			<div><dt>Тревоги</dt><dd class="dashboard-alarm">{ countLabel(len(m.Pulse)) }</dd></div>
			<div><dt>На проверке</dt><dd>{ countLabel(m.ReviewCount) }</dd></div>
			<div><dt>Последний снимок</dt><dd>
				if m.Updated != "" {
					{ m.Updated }
				} else {
					—
				}
			</dd></div>
		</dl>
		@catalogPanel(m)
		if len(m.Diagnostics) != 0 {
			<details class="dashboard-history dashboard-diagnostics">
				<summary>Диагностика источников</summary>
				for _, item := range m.Diagnostics {
					<a class="text-link" href={ item.URL }>{ item.Label } · { item.Detail }</a>
				}
			</details>
		}
		<section class="dashboard-exceptions" aria-label="Открытые исключения">
			<div class="dashboard-heading"><h2>Открытые исключения</h2><small>Потенциал в ₽/нед</small></div>
			if len(m.Pulse) == 0 {
				<p class="dashboard-empty">В этом режиме нет открытых исключений.</p>
			}
			for _, p := range m.Pulse {
				<article class="dashboard-alert">
					<a href={ p.URL } class="dashboard-alert-link">
						<span><strong>{ p.Product }</strong>
							<small class="dashboard-alert-time">{ p.FirstDetected }</small>
							if p.Freshness != "" {
								<small class="dashboard-fresh">{ p.Freshness }</small>
							}
						</span>
						<span class="dashboard-alert-cost">
							if p.Change != "" {
								<strong class="dashboard-alert-change" title={ p.Comparison }>{ p.Change }</strong>
							}
							if p.Weekly != "" {
								<small title={ p.WeeklyBasis }>{ p.Weekly }</small>
							} else {
								<small class="dashboard-alert-cost-reason">Источник даёт индекс, ₽ не рассчитаны</small>
							}
							if p.Comparison != "" {
								<small class="dashboard-alert-period">{ p.Comparison }</small>
							}
						</span>
					</a>
					@coverageBar(p.Coverage)
				</article>
			}
		</section>
	</section>
}

templ investigationPanel(v *Investigation) {
	<section class="monitor-investigation" aria-label="Разбор продукта">
		<div class="investigation-title">
			<div>
				<a href={ v.BackURL } class="monitor-back">Все тревоги</a>
				if v.Title != "" {
					<h2>{ v.Title }</h2>
				} else {
					<h2>{ v.Product }</h2>
				}
				if v.Week != "" {
					<p>{ v.Week }</p>
				}
				if v.FirstDetected != "" {
					<p>{ v.FirstDetected }</p>
				}
			</div>
			if v.Origin != "" {
				<span class="monitor-origin">{ v.Origin }</span>
			}
		</div>
		@panelLifecycle(v.Status)
		if len(v.Coverage) != 0 {
			@coverageBar(v.Coverage)
		}
		if v.Magnitude != nil {
			@signalHeadline(v.Magnitude)
		}
		if v.Chart.Target != "" {
			@trend(v.Chart, v.Control)
		} else {
			<p class="monitor-empty">Для графика нужны сопоставимые замеры продукта.</p>
		}
		if v.ReleaseDate != "" {
			<p class="monitor-release">
				@lucide.Icon("flag", "size-4")
				<time>{ v.ReleaseDate }</time>
				if v.ReleaseURL != "" {
					<a class="text-link" href={ v.ReleaseURL }>{ v.Release }</a>
				} else {
					<span>{ v.Release }</span>
				}
			</p>
		}
		<div class="monitor-facts">
			<div>
				<h4>Доказанность</h4>
				<div class="proof-scale" data-confirmed={ v.Scale == "Подтверждено по замеру" }>
					<span>Не доказано</span><span>Подтверждено</span>
				</div>
				<p>{ v.Scale }</p>
			</div>
			<div>
				<h4>Стоимость потерь</h4>
				if v.Weekly != "" {
					<p class="cost-value" title={ v.WeeklyBasis }>{ v.Weekly }</p>
				}
				if v.Cost != "" {
					<p class="cost-value">{ v.Cost }</p><small>Сценарий по вашим допущениям</small>
				}
				<details class="assumptions" open?={ v.CostError != "" }>
					<summary>Задать допущения</summary>
					<form action="./" method="get">
						if v.CardID != "" {
							<input type="hidden" name="id" value={ v.CardID }/>
						} else {
							<input type="hidden" name="monitor" value={ v.ProductKey }/>
							<input type="hidden" name="snapshot" value={ v.SnapshotID }/>
							<input type="hidden" name="alert" value={ v.AlertID }/>
						}
						<label>Потерянные заказы за неделю<input class="input" required name="orders" inputmode="decimal" value={ v.Orders }/></label>
						<label>Маржа с заказа, ₽<input class="input" required name="margin" inputmode="decimal" value={ v.Margin }/></label>
						if v.CostError != "" {
							<p role="alert">{ v.CostError }</p>
						}
						<button class="btn btn-neutral" type="submit">Рассчитать сценарий</button>
					</form>
				</details>
			</div>
		</div>
		if len(v.Evidence) > 0 || v.RecordURL != "" || v.SnapshotURL != "" {
			<section class="monitor-section">
				<details>
					<summary>Источники</summary>
					for _, e := range v.Evidence {
						<a class="monitor-evidence" href={ e.OpenURL }><span>{ e.Metric }</span><small>{ e.Source }</small></a>
					}
				</details>
				if v.RecordURL != "" {
					<a class="text-link" href={ v.RecordURL }>Открыть гипотезу</a>
				}
				if v.SnapshotURL != "" {
					<a class="text-link" href={ v.SnapshotURL }>Открыть наблюдение</a>
				}
			</section>
		}
	</section>
}

templ trend(c Chart, control string) {
	<figure class="trend">
		<figcaption><strong>Динамика заказов</strong><small>{ c.Caption }</small></figcaption>
		<svg class="trend-svg" viewBox="0 0 600 200" role="img" aria-label="Динамика заказов">
			<path class="trend-grid" d="M30 34H570M30 104H570M30 174H570"></path>
			if c.Fill != "" {
				<polygon class="trend-fill" points={ c.Fill }></polygon>
			}
			if c.ReleaseX != "" {
				<line class="trend-release" x1={ c.ReleaseX } x2={ c.ReleaseX } y1="20" y2="174"></line>
			}
			if c.Counterfactual != "" {
				<polyline class="trend-counterfactual" points={ c.Counterfactual }></polyline>
			}
			if c.Control != "" {
				<polyline class="trend-control" pathLength="1" points={ c.Control }></polyline>
			}
			<polyline class="trend-target" pathLength="1" points={ c.Target }></polyline>
			for _, p := range c.Dots {
				if p.ControlY != "" {
					<circle class="trend-control-dot" cx={ p.X } cy={ p.ControlY } r="4"><title>{ p.Label }</title></circle>
				}
				<circle class="trend-target-dot" cx={ p.X } cy={ p.TargetY } r="4"><title>{ p.Label }</title></circle>
			}
			<text class="trend-tick" x="30" y="21">{ c.Max }</text>
			<text class="trend-tick" x="30" y="196">{ c.First }</text>
			<text class="trend-tick" x="570" y="196" text-anchor="end">{ c.Last }</text>
			<text class="trend-tick" x="570" y="165" text-anchor="end">{ c.Min }</text>
		</svg>
		<div class="trend-keys">
			<span>Продукт</span>
			if c.Control != "" {
				<span>Контроль: { control }</span>
			}
			if c.Counterfactual != "" {
				<span class="counterfactual-key">Если бы продукт шёл как контроль</span>
			}
		</div>
	</figure>
}

templ signalHeadline(m *SignalMagnitude) {
	<div class="signal-headline" aria-label="Размер сигнала">
		<div><strong class="signal-magnitude">{ m.Change }</strong><p>{ m.Caption }</p></div>
		if m.Before != "" && m.After != "" && m.Baseline != "" && m.Current != "" {
			<dl>
				<div><dt>База { m.Baseline }</dt><dd>{ m.Before }</dd></div>
				<div><dt>Текущее окно { m.Current }</dt><dd>{ m.After }</dd></div>
			</dl>
		}
	</div>
}

templ purchasePanel(v *Investigation) {
	<section class="dashboard-screen" aria-label="Путь покупки">
		<div class="dashboard-heading"><h2>Путь покупки</h2><small>{ v.Product }</small></div>
		if len(v.Frames) == 0 {
			<p class="dashboard-empty">Для этого среза нет браузерной проверки.</p>
		} else {
			<div class="monitor-film">
				for _, f := range v.Frames {
					<figure class={ "purchase-frame", f.Tone }>
						if f.Image != "" {
							<a class="film-image" href={ f.Image } target="_blank" rel="noopener">
								<img src={ f.Image } alt={ f.Device + ": " + f.Step } loading="lazy"/>
							</a>
						}
						<figcaption>
							<a href={ f.SourceURL }><strong>{ f.Device }</strong></a><span>{ f.Step }</span><small>{ f.Verdict }</small>
						</figcaption>
					</figure>
				}
			</div>
		}
	</section>
}

templ afterPanel(v *Investigation, decision *Decision) {
	<section class="dashboard-screen" aria-label="После релиза">
		<div class="dashboard-heading"><h2>До и после релиза</h2><small>{ v.Product }</small></div>
		if v.Before != "" && v.After != "" {
			<dl class={ "monitor-compare", templ.KV("measurement-confirmed", v.Status == "supported") }>
				<div><dt>До</dt><dd>{ v.Before }</dd></div>
				<div><dt>После</dt><dd>{ v.After }</dd></div>
			</dl>
		}
		if v.Assessment != "" {
			<p>{ v.Assessment }</p>
		} else {
			<p class="dashboard-empty">Результат появится после сопоставимого замера.</p>
		}
		if decision != nil {
			for _, source := range decision.MeasuredEvidence {
				<a class="text-link" href={ source.URL }>Открыть измерение</a>
			}
		}
	</section>
}
