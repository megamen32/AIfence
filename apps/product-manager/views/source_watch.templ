package views

type SourceWatchRow struct {
	ID, Title, Detail, Status, Review string
	Active                            bool
}

templ SourceWatches(rows []SourceWatchRow, message string, monday string, findings []string) {
	@Layout("Мониторинг источников") {
		<a class="text-link" href="./">Продуктовые решения</a>
		<h1>Мониторинг источников</h1>
		<p>Каждый понедельник в 06:00 UTC сравниваем две завершённые недели. К Метрике подключите Вордстат для выбранной фразы, Market Watch для артикула или оба источника. Разбор запускается при достижении одного из заданных порогов.</p>
		if message != "" {
			<p role="status">{ message }</p>
		}
		for _, text := range findings {
			<p>{ text }</p>
		}
		for _, row := range rows {
			<section class="card card-border p-4 my-3">
				<h2>{ row.Title }</h2>
				<p>{ row.Detail }</p>
				<p>{ row.Status }</p>
				if row.Review!="" {
					<a class="text-link" href={ row.Review }>Открыть последний разбор</a>
				}
				if row.Active {
					<form action="./source-watch" method="post">
						<input type="hidden" name="action" value="stop"/><input type="hidden" name="watch_id" value={ row.ID }/>
						<button class="btn btn-sm" type="submit">@ActionIcon("pause")
Остановить</button>
					</form>
				}
			</section>
		}
		<form action="./source-watch" method="post" class="grid gap-3 max-w-lg my-4">
			<h2>Новая проверка</h2>
			<input type="hidden" name="action" value="start"/>
			<label>Привязка Метрики для compare_periods<input required class="input w-full" name="metrika_binding" maxlength="36"/></label>
			<label>Привязка Вордстата для compare_demand<input class="input w-full" name="wordstat_binding" maxlength="36"/></label>
			<label>Поисковая фраза в Вордстате<input class="input w-full" name="phrase" maxlength="256"/></label>
			<label>Порог снижения спроса, % (по желанию)<input type="number" name="demand_drop_pct" min="0.01" max="100" step="0.01" class="input w-full"/></label>
			<label>Привязка Market Watch для list_offers<input class="input w-full" name="market_binding" maxlength="36"/></label>
			<label>Артикул в Market Watch<input class="input w-full" name="sku" maxlength="128"/></label>
			<label>
				Показатель магазина
				<select name="metric" class="select w-full">
					<option value="visits">Визиты</option><option value="orders">Заказы</option><option value="revenue">Выручка</option><option value="users">Посетители</option><option value="pageviews">Просмотры страниц</option><option value="purchase_conversion">Конверсия в покупку</option><option value="average_order_value">Средний чек</option><option value="product_views">Просмотры товаров</option><option value="add_to_cart">Добавления в корзину</option>
				</select>
			</label>
			<label>Порог снижения, %<input required type="number" name="drop_pct" min="0.01" max="100" step="0.01" value="20" class="input w-full"/></label>
			<label>Первый понедельник<input required type="date" name="monday" value={ monday } class="input w-full"/></label>
			<button type="submit" class="btn btn-primary">@ActionIcon("calendar")
Включить еженедельную проверку</button>
		</form>
	}
}
