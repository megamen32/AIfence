#!/usr/bin/env python3
"""Install the local projection job beside the existing Market Watch importer."""
from pathlib import Path
import os
import plistlib
import subprocess
import sys
import tempfile


def main():
    root = Path(__file__).resolve().parents[3]
    runtime = root / ".runtime"
    if sys.platform != "darwin" or not (runtime / "bin/market-air").is_file():
        raise SystemExit("This installer requires the initialized AIfence Mac checkout")
    label = "local.aifence.market-watch-baserow-matrix"
    folder = Path.home() / "Library/LaunchAgents"
    folder.mkdir(parents=True, exist_ok=True)
    path = folder / f"{label}.plist"
    logs = runtime / "baserow"
    logs.mkdir(mode=0o700, exist_ok=True)
    data = plistlib.dumps({
        "Label": label,
        "ProgramArguments": ["/usr/bin/python3", str(Path(__file__).with_name("sync.py"))],
        "WorkingDirectory": str(root),
        "WatchPaths": [str(runtime / "market-import.log")],
        "StartInterval": 10800,
        "RunAtLoad": False,
        "ProcessType": "Background",
        "StandardOutPath": str(logs / "matrix.log"),
        "StandardErrorPath": str(logs / "matrix-errors.log"),
    })
    changed = not path.exists() or path.read_bytes() != data
    if changed:
        with tempfile.NamedTemporaryFile(dir=folder, delete=False) as tmp:
            tmp.write(data)
            Path(tmp.name).chmod(0o600)
        os.replace(tmp.name, path)
    domain = f"gui/{os.getuid()}"
    target = f"{domain}/{label}"
    loaded = subprocess.run(["launchctl", "print", target], capture_output=True).returncode == 0
    if changed and loaded:
        subprocess.run(["launchctl", "bootout", target], check=True)
        loaded = False
    if not loaded:
        subprocess.run(["launchctl", "bootstrap", domain, str(path)], check=True)
    print(label)


if __name__ == "__main__":
    main()
