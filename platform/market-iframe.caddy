# Chrome partitions the app's embedded login from its standalone session.
# Leave top-level navigation and other applications on the upstream policy.
@market_embedded_login {
	host market-watch.localhost baserow.localhost openai-byok-local.localhost userio-dion-local.localhost
	expression `{http.request.header.Sec-Fetch-Dest} == "iframe" || ({http.request.header.Sec-Fetch-Dest} != "document" && {http.request.header.Sec-Fetch-Storage-Access} != "")`
}
header @market_embedded_login {
	Set-Cookie "^((?:__air_relay_nonce|__air_session)=[^;]*; Path=/; .*; HttpOnly); SameSite=Lax$" "$1; Secure; SameSite=None; Partitioned"
	defer
}
