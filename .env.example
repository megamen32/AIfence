# Optional local settings for AIfence. Copy to .env and adjust; .env stays out
# of Git. No secret belongs in this file or in the repository.

# Target Airlock runtime used by scripts/deploy-apps.
AIRLOCK_URL=http://localhost:42080

# Exact commit to deploy. scripts/deploy-apps requires it to equal
# origin/main after a fetch.
# AIFENCE_DEPLOY_COMMIT=

# Python interpreter used by the deployment scripts.
# AIFENCE_PYTHON=/opt/homebrew/bin/python3

# Private native release path (optional, personal build only).
# The public clean-clone build does not use it.
# AIFENCE_PERSONAL_CACHE=
# AIFENCE_PERSONAL_GIT=

# Optional authorized image cache for the original platform bootstrap.
# AIFENCE_CACHE_HOST=
