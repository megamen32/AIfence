#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
REMOTE_ROOT=$1
BUNDLE=$2
APPS_CSV=$3
IMAGE_REFS=${4:-$BUNDLE/app-image-refs.tsv}
OUTPUT=${5:-$REMOTE_ROOT/.stand-sync/built-image-refs.tsv}
REMOTE_DIR=$(dirname "$BUNDLE")
MANIFEST_DIR="$REMOTE_DIR/manifests"
mkdir -p "$MANIFEST_DIR"
BUILDER=${STAND_SYNC_BUILDER:-default}
oldifs=$IFS
IFS=,
for app in $APPS_CSV; do
  [ -n "$app" ] || continue
  appdir=$BUNDLE/apps/$app
  [ -d "$appdir" ] || { echo "bundle is missing apps/$app" >&2; exit 44; }
  image_ref=$(awk -F '\t' -v a="$app" 'NR>1 && $1==a {print $2; exit}' "$IMAGE_REFS" 2>/dev/null || true)
  [ -n "$image_ref" ] || image_ref="aifence-$app:stand-sync-$(date -u +%Y%m%dT%H%M%S)"
  [ -f "$appdir/Dockerfile" ] || { echo "apps/$app/Dockerfile is required for native target build" >&2; exit 45; }
  dockerfile="$appdir/Dockerfile.stand-sync"
  sed -e 's/go mod tidy &&/true \&\&/' \
      -e 's/go build -o \/agent/GOFLAGS=-mod=vendor GOPROXY=off go build -mod=vendor -o \/agent/' \
      "$appdir/Dockerfile" > "$dockerfile"
  BUILDX_BUILDER="$BUILDER" docker build --pull=false -f "$dockerfile" -t "$image_ref" "$appdir" < /dev/null 1>&2
  rm -f "$dockerfile"
  docker run --rm -e AIRLOCK_AGENT_MODE=manifest "$image_ref" > "$MANIFEST_DIR/$app.json"
  chmod 600 "$MANIFEST_DIR/$app.json"
  printf '%s\t%s\n' "$app" "$image_ref"
done > "$OUTPUT"
IFS=$oldifs
