#!/usr/bin/env python3
"""Read aggregate Airlock model usage for one AIfence conversation from the stand."""
import argparse
import subprocess
from uuid import UUID

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("conversation", type=UUID)
parser.add_argument("--context", help="Docker context for the isolated stand")
parser.add_argument("--postgres", default="aifence-postgres-1")
args = parser.parse_args()
docker = ["docker"]
if args.context:
    docker += ["--context", args.context]
query = """
BEGIN READ ONLY;
WITH measured AS (
  SELECT id, status, llm_calls AS calls, llm_tokens_in AS input, llm_tokens_out AS output,
         started_at, finished_at, 'Airlock runs' AS meter
  FROM runs WHERE trigger_ref = :'chat' AND trigger_type = 'prompt'
  UNION ALL
  SELECT r.id, r.status, COALESCE(u.calls, r.llm_calls),
         CASE WHEN u.calls IS NULL THEN r.llm_tokens_in WHEN u.reported THEN u.input END,
         CASE WHEN u.calls IS NULL THEN r.llm_tokens_out WHEN u.reported THEN u.output END,
         r.started_at, r.finished_at, 'Airlock system chat'
  FROM system_runs r
  LEFT JOIN (
    SELECT system_run_id, count(*) AS calls, sum(tokens_in) AS input, sum(tokens_out) AS output,
           bool_and(tokens_in > 0 OR tokens_out > 0) AS reported
    FROM llm_usage WHERE system_run_id IN (SELECT id FROM system_runs WHERE conversation_id = :'chat')
    GROUP BY system_run_id
  ) u ON u.system_run_id = r.id
  WHERE r.conversation_id = :'chat'
)
SELECT json_build_object(
  'run_id', id, 'status', status, 'model_calls', calls,
  'usage_reported', COALESCE(input > 0 OR output > 0, false),
  'input_tokens', CASE WHEN input > 0 OR output > 0 THEN input END,
  'output_tokens', CASE WHEN input > 0 OR output > 0 THEN output END,
  'run_seconds', ROUND(EXTRACT(EPOCH FROM (finished_at - started_at))::numeric, 2),
  'meter', meter
)
FROM measured ORDER BY started_at;
COMMIT;
"""
command = docker + ["exec", "-i", args.postgres, "sh", "-c",
    'exec psql -XqtA -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB" "$@"',
    "psql", "-v", f"chat={args.conversation}"]
subprocess.run(command, input=query, text=True, check=True, timeout=20)
