#!/usr/bin/env bash
# Stage tracked app sources outside the checkout; never bypass SDK source CAS.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="$PATH:/opt/homebrew/bin:/usr/local/go/bin:$HOME/go/bin"
python_bin="${AIFENCE_PYTHON:-/opt/homebrew/bin/python3}"
if [[ ! -x "$python_bin" ]]; then python_bin="$(command -v python3)"; fi
export GOMAXPROCS="${GOMAXPROCS:-2}" GOFLAGS="${GOFLAGS:--p=1}"
verify_main_release() {
  git -C "$ROOT" fetch origin main
  "$python_bin" - "$ROOT" "$commit" "${1:-}" <<'VERIFY_MAIN'
import json, pathlib, subprocess, sys
root, commit = pathlib.Path(sys.argv[1]), sys.argv[2]
origin_main = subprocess.check_output(["git", "-C", str(root), "rev-parse", "refs/remotes/origin/main"], text=True).strip()
if commit != origin_main:
    sys.exit("Live deployment requires the target commit to equal origin/main after fetch; build integration candidates with personal-build-apps.py --commit")
for name in ("scripts/deploy-apps", "scripts/personal-build-apps.py", "scripts/personal-source-bundle.go", "platform/personal-release.lock.json"):
    data = subprocess.check_output(["git", "-C", str(root), "show", commit + ":" + name])
    path = root / name
    if path.is_symlink() or not path.is_file() or path.read_bytes() != data:
        sys.exit(name + " differs from the selected main commit; commit the deployment inputs first")
# Load trusted policy code from the selected commit, not an editable worktree helper.
policy_path = "scripts/personal-mac-rollout.py"
policy_source = subprocess.check_output(["git", "-C", str(root), "show", commit + ":" + policy_path])
policy = {"__name__": "personal_release_policy", "__file__": str(root / policy_path)}
exec(compile(policy_source, commit + ":" + policy_path, "exec"), policy)
if sys.platform == "darwin":
    approved_path = pathlib.Path.home() / "AIfence/.runtime/personal-releases/current"
elif sys.platform == "linux":
    approved_path = pathlib.Path("/home/roomhacker/Airlock/personal/releases/current")
else:
    sys.exit("Live personal deployment requires an installed M1 or server-88 release policy")
frozen, _, approved, _ = policy["approved_release"](approved_path)
lock = json.loads(subprocess.check_output([
    "git", "-C", str(root), "show", commit + ":platform/personal-release.lock.json"]))
pins = {name: policy["digest"](lock.get(name), 40, "app platform " + name)
        for name in ("airlock", "agentsdk", "sol")}
if frozen and pins != approved:
    sys.exit("App platform dependencies differ from the frozen release")
if sys.argv[3]:
    receipt = json.loads(pathlib.Path(sys.argv[3]).read_bytes())
    if receipt.get("source_commit") != commit or {name: receipt.get(name) for name in pins} != pins:
        sys.exit("App bundle platform dependencies or source commit differ from the committed release lock")
VERIFY_MAIN
}
usage() { echo "Usage: $0 [--dry-run] [--create] market-watch|metrika-analyst|product-manager|competitor-research|web-scraper|google-trends|wordstat" >&2; exit 2; }
dry=0 create=0 auto=0 slug=""
for arg in "$@"; do
  case "$arg" in
    --dry-run) dry=1;; --create) create=1;; --auto) auto=1;;
    market-watch|metrika-analyst|product-manager|competitor-research|web-scraper|google-trends|wordstat) [[ -z "$slug" ]] || usage; slug="$arg";;
    *) usage;;
  esac
done
if [[ -z "$slug" ]]; then
  [[ "$create" == 0 && "$auto" == 0 ]] || usage
  export AIFENCE_DEPLOY_COMMIT="$(git -C "$ROOT" rev-parse --verify --end-of-options "${AIFENCE_DEPLOY_COMMIT:-HEAD}^{commit}")"
  for app in market-watch metrika-analyst product-manager; do
    if [[ "$dry" == 1 ]]; then "$0" --dry-run "$app"; else "$0" --auto "$app"; fi
  done
  exit 0
fi
commit="$(git -C "$ROOT" rev-parse --verify --end-of-options "${AIFENCE_DEPLOY_COMMIT:-HEAD}^{commit}")"
verify_main_release
url="${AIRLOCK_URL:-http://localhost:42080}"
origin_key="$("$python_bin" - "$url" <<'ORIGIN'
import hashlib, sys, urllib.parse
u = urllib.parse.urlsplit(sys.argv[1])
if u.scheme not in ('http', 'https') or not u.hostname or u.username or u.password or u.path not in ('', '/') or u.query or u.fragment:
    sys.exit('AIRLOCK_URL must be an HTTP(S) origin without credentials or path')
try:
    port = u.port
except ValueError:
    sys.exit('Invalid AIRLOCK_URL port')
host = u.hostname.lower()
if ':' in host: host = '[' + host + ']'
if port and port != (443 if u.scheme == 'https' else 80): host += ':' + str(port)
print(hashlib.sha256((u.scheme.lower() + '://' + host).encode()).hexdigest())
ORIGIN
)"
common_git_dir="$(git -C "$ROOT" rev-parse --path-format=absolute --git-common-dir)"
base="$common_git_dir/aifence-deploy"
mkdir -p "$base/stages"
chmod 700 "$base" "$base/stages"
lock=""
state="$base/state/$origin_key/$slug"
if [[ "$dry" == 0 ]]; then
  mkdir -p "$base/state"
  chmod 700 "$base/state"
  lock="$base/state/$origin_key-$slug.lock"
  if ! mkdir "$lock" 2>/dev/null; then echo "Another deployment owns $lock; inspect before removing it." >&2; exit 1; fi
fi
stage=""
cleanup() {
  result=$?
  if [[ "$dry" == 0 && -n "$stage" && -f "$stage/.airlock/local/agent.toml" ]]; then
    mkdir -p "$state"
    chmod 700 "$state"
    cp "$stage/.airlock/local/agent.toml" "$state/agent.toml.tmp.$$"
    chmod 600 "$state/agent.toml.tmp.$$"
    mv "$state/agent.toml.tmp.$$" "$state/agent.toml"
    if [[ "$result" == 0 ]]; then printf '%s\n' "$commit" > "$state/deployed-commit"; fi
  fi
  if [[ -n "$lock" ]]; then rmdir "$lock"; fi
  if [[ -n "$stage" ]]; then echo "Staging retained: $stage" >&2; fi
  exit "$result"
}
trap cleanup EXIT
stage="$(mktemp -d "$base/stages/$slug.XXXXXXXX")"
"$python_bin" - "$ROOT" "$slug" "$stage" "$commit" <<'PY'
import os, pathlib, shutil, subprocess, sys, tomllib
root, slug, stage, commit = pathlib.Path(sys.argv[1]), sys.argv[2], pathlib.Path(sys.argv[3]), sys.argv[4]
prefix = f'apps/{slug}/'
raw = subprocess.check_output(['git', '-C', str(root), 'ls-tree', '-rz', '--full-tree', commit, '--', prefix])
entries = {}
for item in raw.split(b'\0'):
    if not item: continue
    meta, path = item.split(b'\t', 1)
    mode, kind, oid = meta.decode().split()
    entries[os.fsdecode(path)] = (mode, kind, oid)
if not entries:
    sys.exit('No committed app sources')
files = list(entries)
ignored = subprocess.run(['git', '-C', str(root), 'check-ignore', '--no-index', '-z', '--stdin'], input=b'\0'.join(os.fsencode(p) for p in files)+b'\0', stdout=subprocess.PIPE, check=False)
if ignored.returncode not in (0, 1):
    sys.exit('Could not check ignore rules')
excluded = set(os.fsdecode(p) for p in ignored.stdout.split(b'\0') if p)
for path, (mode, kind, oid) in entries.items():
    rel = pathlib.PurePosixPath(path[len(prefix):])
    if path in excluded or any(part in {'data', 'private', 'materials', 'материалы', '.runtime', '.airlock'} for part in rel.parts):
        continue
    if kind != 'blob' or mode not in ('100644', '100755'):
        sys.exit(f'Refusing non-regular committed source: {path}')
    dst = stage / rel
    dst.parent.mkdir(parents=True, exist_ok=True)
    with dst.open('xb') as out:
        subprocess.run(['git', '-C', str(root), 'cat-file', 'blob', oid], stdout=out, check=True)
    os.chmod(dst, 0o755 if mode == '100755' else 0o644)
# The PM may select this one cross-app runtime file. Use the same commit,
# never a potentially different or private working-tree file.
config = stage / 'airlock.toml'
if slug == 'product-manager' and config.exists():
    try:
        runtime_files = tomllib.loads(config.read_text(encoding='utf-8')).get('build', {}).get('runtime_files', [])
    except (tomllib.TOMLDecodeError, AttributeError) as exc:
        sys.exit(f'Invalid airlock.toml: {exc}')
    if not isinstance(runtime_files, list) or any(not isinstance(x, str) for x in runtime_files):
        sys.exit('Invalid build.runtime_files in airlock.toml')
    if 'pathcheck/check_purchase_path.py' in runtime_files:
        source = 'apps/path-check/check_purchase_path.py'
        entry = subprocess.check_output(['git', '-C', str(root), 'ls-tree', '-z', commit, '--', source]).split(b'\0')
        entry = [x for x in entry if x]
        if len(entry) != 1:
            sys.exit(f'Required runtime file must be committed: {source}')
        meta, indexed_path = entry[0].split(b'\t', 1)
        mode, kind, oid = meta.decode().split()
        if os.fsdecode(indexed_path) != source or kind != 'blob' or mode not in ('100644', '100755'):
            sys.exit(f'Required runtime file is not a regular Git blob: {source}')
        dest = stage / 'pathcheck' / 'check_purchase_path.py'
        if dest.exists() or dest.is_symlink():
            sys.exit(f'Refusing to overwrite staged runtime file: {dest}')
        dest.parent.mkdir(parents=True, exist_ok=True)
        with dest.open('xb') as out:
            subprocess.run(['git', '-C', str(root), 'cat-file', 'blob', oid], stdout=out, check=True)
        os.chmod(dest, 0o755 if mode == '100755' else 0o644)
        print(f'Staged runtime file from Git object {oid}: {source}')
required_files = ['go.mod', 'go.sum', 'main.go', 'styles/app.css']
if slug == 'metrika-analyst':
    required_files += ['INSTRUCTIONS.md', 'index.html']
for required in required_files:
    if not (stage / required).is_file():
        sys.exit(f'Missing tracked SDK build input: {required}')
if b'github.com/a-h/templ/cmd/templ' not in (stage / 'go.mod').read_bytes():
    sys.exit('Missing templ tool directive in tracked go.mod (required by SDK build)')
(stage / 'views' / 'static').mkdir(parents=True, exist_ok=True)
print(f'Staged {slug} from committed source {commit}; private/data directories excluded.')
PY
if [[ "$dry" == 1 ]]; then
  echo "Dry run: no build, login, upload, or deployment."
  exit 0
fi
# Build the pinned native profile and unpack the exact validated source bundle.
# The builder's recursive --dry-run only stages sources and never takes this lock.
release_dir="$(mktemp -d "$base/stages/$slug-release.XXXXXXXX")"
"$python_bin" "$ROOT/scripts/personal-build-apps.py" --commit "$commit" --app "$slug" --output "$release_dir/packages"
native_stage="$(mktemp -d "$base/stages/$slug-native.XXXXXXXX")"
"$python_bin" - "$release_dir/packages/apps.json" "$slug" "$commit" "$native_stage" <<'UNPACK_NATIVE'
import hashlib, json, pathlib, sys, tarfile
receipt, slug, commit, destination = pathlib.Path(sys.argv[1]), sys.argv[2], sys.argv[3], pathlib.Path(sys.argv[4])
record = json.loads(receipt.read_text())
packages = [p for p in record["packages"] if p["app"] == slug]
if record["source_commit"] != commit or len(packages) != 1 or packages[0]["source_commit"] != commit:
    sys.exit("Native source bundle does not match the selected commit")
package = packages[0]
if package["file"] != slug + ".tar.gz":
    sys.exit("Unexpected native source bundle name")
archive_path = receipt.parent / package["file"]
with archive_path.open("rb") as stream:
    digest = hashlib.file_digest(stream, "sha256").hexdigest()
if digest != package["sha256"] or archive_path.stat().st_size != package["size"]:
    sys.exit("Native source bundle differs from its build receipt")
with tarfile.open(archive_path) as archive:
    archive.extractall(destination, filter="data")
UNPACK_NATIVE
stage="$native_stage"
verify_main_release "$release_dir/packages/apps.json"
# Import only an actual synchronized SDK binding. Never manufacture or refresh
# its source ETag to make a stale workspace pass the server's source CAS.
mkdir -p "$stage/.airlock/local"
if [[ -f "$state/agent.toml" ]]; then
  cp "$state/agent.toml" "$stage/.airlock/local/agent.toml"
elif [[ -n "${AIFENCE_BINDING_FILE:-}" ]]; then
  [[ -f "$AIFENCE_BINDING_FILE" ]] || { echo 'AIFENCE_BINDING_FILE does not exist' >&2; exit 1; }
  "$python_bin" - "$AIFENCE_BINDING_FILE" "$url" <<'CHECK_BINDING'
import sys, tomllib, urllib.parse
with open(sys.argv[1], 'rb') as f: binding = tomllib.load(f)
def origin(value):
    u = urllib.parse.urlsplit(value)
    port = u.port or (443 if u.scheme == 'https' else 80)
    return (u.scheme.lower(), (u.hostname or '').lower(), port, u.path.rstrip('/'))
remotes = binding.get('remotes', {})
if not remotes or any(origin(r.get('url', '')) != origin(sys.argv[2]) for r in remotes.values()):
    sys.exit('Binding origin missing or mismatched; refusing import')
CHECK_BINDING
  cp "$AIFENCE_BINDING_FILE" "$stage/.airlock/local/agent.toml"
fi
if [[ "$create" == 1 && -f "$stage/.airlock/local/agent.toml" ]]; then
  echo 'Refusing --create with existing binding; inspect state first.' >&2; exit 1
fi
cd "$stage"
if [[ "$auto" == 1 ]]; then
  decision="$( (go tool air status --target production --url "$url" --agent "$slug" --json || true) | "$python_bin" -c '
import json, sys
try: d = json.load(sys.stdin)
except (ValueError, OSError): sys.exit("Cannot inspect target; refusing automatic creation")
if d.get("status") != "failed": print("existing")
elif d.get("error", {}).get("message", "").startswith("agent \"" + sys.argv[1] + "\" not found in "): print("create")
else: sys.exit("Cannot inspect target; refusing automatic creation: " + d.get("error", {}).get("message", "unknown SDK error"))
' "$slug")"
  [[ "$decision" != create ]] || create=1
fi
if [[ "$create" == 1 && -f "$stage/.airlock/local/agent.toml" ]]; then
  echo 'Refusing --create with existing binding; inspect state first.' >&2; exit 1
fi
verify_main_release "$release_dir/packages/apps.json"
mkdir -p "$state"
chmod 700 "$state"
printf '%s\n' "$commit" > "$state/desired-commit"
if [[ "$create" == 1 ]]; then
  go tool air deploy --target production --url "$url" --create --name "$slug" --slug "$slug" -m "AIfence $slug $commit" --wait
else
  go tool air deploy --target production --url "$url" --agent "$slug" -m "AIfence $slug $commit" --wait
fi
go tool air status --target production --url "$url" --agent "$slug" --wait
