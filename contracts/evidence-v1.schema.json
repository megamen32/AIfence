{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifence.example/contracts/evidence-v1.json",
  "title": "AIfence evidence batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "as_of",
    "status",
    "observations",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "aifence.v1"
    },
    "source": {
      "enum": [
        "market",
        "metrika",
        "wordstat",
        "sales",
        "research",
        "backlog",
        "release",
        "economics",
        "browser",
        "competitor"
      ]
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "unavailable"
      ]
    },
    "observations": {
      "type": "array"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "baseObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "product_key",
        "metric_key",
        "value",
        "unit",
        "period",
        "source_ref",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        },
        "product_key": {
          "type": "string",
          "minLength": 1
        },
        "metric_key": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "unit": {
          "type": "string"
        },
        "period": {
          "type": "object",
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "type": "string",
              "format": "date"
            },
            "to": {
              "type": "string",
              "format": "date"
            }
          },
          "additionalProperties": false
        },
        "segment": {
          "type": "string"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "tax_basis": {
          "enum": [
            "included",
            "excluded",
            "unknown",
            "not_applicable"
          ]
        },
        "sample_size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "numerator": {
          "type": [
            "number",
            "null"
          ]
        },
        "denominator": {
          "type": [
            "number",
            "null"
          ]
        },
        "source_ref": {
          "type": "object",
          "required": [
            "source_id",
            "locator"
          ],
          "properties": {
            "source_id": {
              "type": "string",
              "minLength": 1
            },
            "locator": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "status": {
          "enum": [
            "observed",
            "missing",
            "incomparable",
            "estimated"
          ]
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "comparison_key": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "missing"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "observation": {
      "allOf": [
        {"$ref": "#/$defs/baseObservation"},
        {"properties": {"kind": {"enum": ["metric", "offer", "research", "task", "release", "cost", "path_check"]}, "value": {"type": ["number", "string", "boolean", "null"]}}}
      ]
    },
    "name": {"type": "string", "minLength": 1},
    "setValue": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
    "competitorRecord": {
      "allOf": [
        {"$ref": "#/$defs/baseObservation"},
        {"$ref": "#/$defs/competitorValueTypes"},
        {
          "if": {"properties": {"kind": {"const": "competitor_change"}}},
          "then": {"$ref": "#/$defs/competitorChange"},
          "else": {
            "if": {"properties": {"status": {"const": "observed"}}},
            "then": {"properties": {"value": {"not": {"type": "null"}}}}
          }
        }
      ],
      "required": ["details"],
      "properties": {
        "kind": {"enum": ["competitor_observation", "competitor_change"]},
        "details": {
          "type": "object",
          "required": ["competitor", "value_type", "origin"],
          "properties": {
            "competitor": {"$ref": "#/$defs/name"},
            "value_type": {"enum": ["number", "boolean", "set"]},
            "origin": {"enum": ["agent_collected", "customer_research"]},
            "screenshot_ref": {"$ref": "#/$defs/name"}
          }
        }
      },
      "anyOf": [
        {"properties": {"source_ref": {"required": ["url"], "properties": {"url": {"type": "string", "format": "uri", "pattern": "^https?://[^/ ]+"}}}}},
        {"properties": {"details": {"required": ["screenshot_ref"]}}}
      ]
    },
    "competitorValueTypes": {
      "oneOf": [
        {
          "properties": {"details": {"properties": {"value_type": {"const": "number"}, "before": {"type": "number"}, "after": {"type": "number"}}}},
          "if": {"properties": {"kind": {"const": "competitor_observation"}}},
          "then": {"properties": {"value": {"anyOf": [{"type": "number"}, {"type": "null"}]}}}
        },
        {
          "properties": {"details": {"properties": {"value_type": {"const": "boolean"}, "before": {"type": "boolean"}, "after": {"type": "boolean"}}}},
          "if": {"properties": {"kind": {"const": "competitor_observation"}}},
          "then": {"properties": {"value": {"anyOf": [{"type": "boolean"}, {"type": "null"}]}}}
        },
        {
          "properties": {"details": {"properties": {"value_type": {"const": "set"}, "before": {"$ref": "#/$defs/setValue"}, "after": {"$ref": "#/$defs/setValue"}}}},
          "if": {"properties": {"kind": {"const": "competitor_observation"}}},
          "then": {"properties": {"value": {"anyOf": [{"$ref": "#/$defs/setValue"}, {"type": "null"}]}}}
        }
      ]
    },
    "competitorChange": {
      "properties": {
        "value": {"type": ["boolean", "null"]},
        "unit": {"const": "boolean"},
        "details": {
          "required": ["rule", "before", "after", "confirmed_by_second_snapshot", "snapshot_ids"],
          "properties": {
            "rule": {"$ref": "#/$defs/name"},
            "confirmed_by_second_snapshot": {"type": "boolean"},
            "snapshot_ids": {"type": "array", "items": {"$ref": "#/$defs/name"}, "uniqueItems": true, "minItems": 2}
          },
          "if": {"properties": {"confirmed_by_second_snapshot": {"const": true}}},
          "then": {"properties": {"snapshot_ids": {"minItems": 3}}}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "observed"}}},
          "then": {"properties": {"value": {"type": "boolean"}}},
          "else": {"properties": {"value": {"type": "null"}}}
        },
        {
          "if": {"properties": {"value": {"const": true}, "details": {"properties": {"value_type": {"const": "number"}}}}},
          "then": {"properties": {"details": {"properties": {"confirmed_by_second_snapshot": {"const": true}}}}}
        }
      ]
    }
  },
  "if": {"properties": {"source": {"const": "competitor"}}},
  "then": {"properties": {"observations": {"items": {"$ref": "#/$defs/competitorRecord"}}}},
  "else": {"properties": {"observations": {"items": {"$ref": "#/$defs/observation"}}}}
}
